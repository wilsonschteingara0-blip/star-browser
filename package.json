{
  "name": "star-browser",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Star Browser — a calmer, lighter Chromium browser with a constellation of built-in apps.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "desktop": "node scripts/desktop.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist:desktop": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "main": "desktop/main.cjs",
  "author": "Star Browser"
}
